{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestao-fpy-iuran",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestao-fpy-db",
      "database_id": "e3e14e38-ca21-40c8-a804-cd2eca5ec52c",
    },
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"],
    },
  ],
  "observability": { "enabled": true },
}
